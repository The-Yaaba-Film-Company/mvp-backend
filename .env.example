# Point this at a real cloud Supabase Postgres project (SPEC.md §2, no local Supabase).
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# Empty string disables Sentry (required policy fields: see AGENTS.md "Sentry policy").
SENTRY_DSN=

# Set to true in production so session/csrf cookies only travel over TLS.
SESSION_COOKIE_SECURE=false

# NVIDIA API key (used by the AI pipeline, Epic 4). Free at https://build.nvidia.com/.
NVIDIA_API_KEY=
# OpenAI-compatible base URL (NVIDIA NIM default).
AI_BASE_URL=https://integrate.api.nvidia.com/v1