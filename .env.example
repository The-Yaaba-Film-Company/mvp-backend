# Point this at a real cloud Supabase Postgres project (SPEC.md §2, no local Supabase).
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# Empty string disables Sentry (required policy fields: see AGENTS.md "Sentry policy").
SENTRY_DSN=

# Set to true in production so session/csrf cookies only travel over TLS.
SESSION_COOKIE_SECURE=false

# Gemini API key (used by the AI pipeline, Epic 4). Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Gemini model used by the AI extraction pipeline.
GEMINI_MODEL=gemini-3.6-flash